# ================================================
# HCAL 연구실 홈페이지 - .gitignore
# ================================================


# -----------------------------------------------
# [OS 자동 생성 파일] - 운영체제가 자동으로 만드는 불필요한 파일
# -----------------------------------------------

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS (협업 시 대비)
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes


# -----------------------------------------------
# [에디터 / IDE 설정 파일] - 개인 개발환경 설정은 공유 불필요
# -----------------------------------------------

# VS Code
.vscode/
*.code-workspace

# JetBrains (WebStorm 등)
.idea/
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Emacs 임시 파일
*~
*.swp
*.swo


# -----------------------------------------------
# [작업 메모 / 개인 문서] - git 이력 관리 메모 등
# -----------------------------------------------
git반영.txt


# -----------------------------------------------
# [빌드 / 캐시] - 향후 빌드 도구 도입 시 대비
# -----------------------------------------------
node_modules/
dist/
build/
.cache/
*.log
npm-debug.log*


# -----------------------------------------------
# [민감한 정보] - 절대 올리면 안 되는 파일
# -----------------------------------------------
.env
.env.local
.env.*.local
secrets.*
*.pem
*.key
